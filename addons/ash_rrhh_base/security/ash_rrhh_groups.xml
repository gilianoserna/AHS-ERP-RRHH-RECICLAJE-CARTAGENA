<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ash_rrhh" model="ir.module.category">
        <field name="name">ASH Gestión de empleados</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_ash_rrhh" model="res.groups.privilege">
        <field name="name">ASH Gestión de empleados</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_ash_rrhh"/>
    </record>

    <record id="group_ash_rrhh_empleado" model="res.groups">
        <field name="name">Empleado</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_ash_rrhh"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ve sus turnos, marca asistencia y solicita permisos.</field>
    </record>

    <record id="group_ash_rrhh_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_ash_rrhh"/>
        <field name="implied_ids" eval="[(4, ref('group_ash_rrhh_empleado')), (4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Programa turnos y revisa asistencia y permisos de su equipo.</field>
    </record>

    <record id="group_ash_rrhh_gestor" model="res.groups">
        <field name="name">Gestor RRHH</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_ash_rrhh"/>
        <field name="implied_ids" eval="[(4, ref('group_ash_rrhh_supervisor')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="comment">Configura parámetros, aprueba y envía novedades a Alegra.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
