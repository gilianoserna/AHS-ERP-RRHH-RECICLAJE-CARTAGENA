<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ash_rrhh_parametro_list" model="ir.ui.view">
        <field name="name">ash.rrhh.parametro.list</field>
        <field name="model">ash.rrhh.parametro</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="clave"/>
                <field name="valor"/>
                <field name="vigente_desde"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="fuente"/>
            </list>
        </field>
    </record>
    <record id="ash_rrhh_festivo_list" model="ir.ui.view">
        <field name="name">ash.rrhh.festivo.list</field>
        <field name="model">ash.rrhh.festivo</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="fecha"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="manual"/>
            </list>
        </field>
    </record>

    <record id="action_ash_rrhh_parametro" model="ir.actions.act_window">
        <field name="name">Parámetros laborales</field>
        <field name="res_model">ash.rrhh.parametro</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_ash_rrhh_festivo" model="ir.actions.act_window">
        <field name="name">Festivos</field>
        <field name="res_model">ash.rrhh.festivo</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_ash_rrhh_root" name="Gestión de empleados" sequence="40"
              groups="group_ash_rrhh_empleado" web_icon="hr,static/description/icon.png"/>
    <menuitem id="menu_ash_rrhh_empleados" name="Empleados" parent="menu_ash_rrhh_root"
              action="hr.open_view_employee_list_my" sequence="10" groups="group_ash_rrhh_supervisor"/>
    <menuitem id="menu_ash_rrhh_config" name="Configuración" parent="menu_ash_rrhh_root"
              sequence="90" groups="group_ash_rrhh_gestor"/>
    <menuitem id="menu_ash_rrhh_parametro" name="Parámetros laborales" parent="menu_ash_rrhh_config"
              action="action_ash_rrhh_parametro" sequence="10"/>
    <menuitem id="menu_ash_rrhh_festivo" name="Festivos" parent="menu_ash_rrhh_config"
              action="action_ash_rrhh_festivo" sequence="20"/>
</odoo>
