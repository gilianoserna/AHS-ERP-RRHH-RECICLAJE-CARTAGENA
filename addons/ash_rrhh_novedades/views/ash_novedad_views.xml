<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ash_novedad_periodo_list" model="ir.ui.view">
        <field name="name">ash.novedad.periodo.list</field>
        <field name="model">ash.novedad.periodo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fecha_desde"/>
                <field name="fecha_hasta"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="total_lineas"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ash_novedad_periodo_form" model="ir.ui.view">
        <field name="name">ash.novedad.periodo.form</field>
        <field name="model">ash.novedad.periodo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calcular" type="object" string="Calcular novedades" class="btn-primary"
                            invisible="estado not in ('borrador', 'calculado')"/>
                    <button name="action_aprobar" type="object" string="Aprobar" class="btn-primary"
                            invisible="estado != 'calculado'"/>
                    <button name="action_exportar_csv" type="object" string="Descargar CSV para Alegra"
                            invisible="estado not in ('aprobado', 'enviado')"/>
                    <button name="action_volver_borrador" type="object" string="Volver a borrador"
                            invisible="estado not in ('calculado', 'aprobado')"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="asistencias_sin_turno == 0">
                        Hay <field name="asistencias_sin_turno" class="oe_inline"/> marcaciones sin turno en el
                        periodo. Revíselas antes de aprobar.
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="Nómina 1.ª quincena noviembre 2026"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="fecha_desde"/>
                            <field name="fecha_hasta"/>
                            <field name="calculado_por"/>
                            <field name="aprobado_por"/>
                        </group>
                    </group>
                    <field name="linea_ids" readonly="estado in ('aprobado', 'enviado')">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="concepto"/>
                            <field name="cantidad"/>
                            <field name="unidad"/>
                            <field name="fecha_inicio" optional="show"/>
                            <field name="fecha_fin" optional="show"/>
                            <field name="origen" readonly="1"/>
                            <field name="observacion" optional="hide"/>
                            <field name="estado_envio" optional="show" readonly="1"/>
                            <field name="error_envio" optional="hide" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ash_novedad_concepto_list" model="ir.ui.view">
        <field name="name">ash.novedad.concepto.list</field>
        <field name="model">ash.novedad.concepto</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="clave"/>
                <field name="codigo_alegra"/>
                <field name="unidad"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_ash_novedad_periodo" model="ir.actions.act_window">
        <field name="name">Novedades de nómina</field>
        <field name="res_model">ash.novedad.periodo</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ash_novedad_concepto" model="ir.actions.act_window">
        <field name="name">Conceptos de Alegra</field>
        <field name="res_model">ash.novedad.concepto</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_ash_novedades" name="Novedades para Alegra" parent="ash_rrhh_base.menu_ash_rrhh_root"
              action="action_ash_novedad_periodo" sequence="50" groups="ash_rrhh_base.group_ash_rrhh_supervisor"/>
    <menuitem id="menu_ash_novedad_concepto" name="Conceptos de Alegra" parent="ash_rrhh_base.menu_ash_rrhh_config"
              action="action_ash_novedad_concepto" sequence="50"/>
</odoo>
