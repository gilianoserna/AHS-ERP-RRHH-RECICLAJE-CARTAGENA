<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_periodo_compania" model="ir.rule">
        <field name="name">Novedades: solo periodos de mis compañías</field>
        <field name="model_id" ref="model_ash_novedad_periodo"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_linea_compania" model="ir.rule">
        <field name="name">Novedades: solo líneas de mis compañías</field>
        <field name="model_id" ref="model_ash_novedad_linea"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
